+function readPriorVectors(file, model, maxDocumentCharacters) {
+  const absoluteFile = path.resolve(file)
+  for (let attempt = 0; attempt < 2; attempt += 1) {
+    let before
+    try {
+      before = fs.statSync(absoluteFile, { bigint: true })
+    } catch (error) {
+      PARSED_VECTOR_CACHE = null
+      if (error.code === "ENOENT") return {}
+      throw error
+    }
+    const beforeSignature = vectorFileSignature(before)
+    if (PARSED_VECTOR_CACHE?.file === absoluteFile && PARSED_VECTOR_CACHE.signature === beforeSignature) {
+      return PARSED_VECTOR_CACHE.vectors
+    }
+    PARSED_VECTOR_CACHE = null
+
+    let parsed
+    try {
+      parsed = JSON.parse(fs.readFileSync(absoluteFile, "utf8"))
+    } catch (error) {
+      PARSED_VECTOR_CACHE = null
+      if (error.code === "ENOENT" || error instanceof SyntaxError) return {}
+      throw error
+    }
+
+    let after
+    try {
+      after = fs.statSync(absoluteFile, { bigint: true })
+    } catch (error) {
+      PARSED_VECTOR_CACHE = null
+      if (error.code === "ENOENT") return {}
+      throw error
+    }
+    const afterSignature = vectorFileSignature(after)
+    if (beforeSignature !== afterSignature) continue
+
+    const vectors = parsed.version === 1 && parsed.model === model && parsed.maxDocumentCharacters === maxDocumentCharacters
+      ? parsed.vectors ?? {}
+      : {}
+    PARSED_VECTOR_CACHE = { file: absoluteFile, signature: afterSignature, vectors }
+    return vectors
+  }
+
+  PARSED_VECTOR_CACHE = null
+  return {}
+}
+
+function vectorFileSignature(stat) {
+  return [stat.dev, stat.ino, stat.size, stat.mtimeNs, stat.ctimeNs].map(String).join(":")
