+test("the parsed vector cache observes external atomic replacement", async () => {
+  const directory = fs.mkdtempSync(path.join(os.tmpdir(), "graphmory-semantic-replace-"))
+  try {
+    let embedded = 0
+    const embed = async (texts) => {
+      embedded += texts.length
+      return { tolist: () => texts.map((text) => [text.length, 1]) }
+    }
+    const options = { vault: directory, model: "test-model", modelCache: directory, maxDocumentCharacters: 100 }
+    const documents = [parseMarkdown("a.md", "# A\n\noriginal")]
+    await cachedDocumentVectors(documents, embed, options)
+    await cachedDocumentVectors(documents, embed, options)
+    assert.equal(embedded, 1)
+
+    const file = onlyVectorCacheFile(directory)
+    const cached = JSON.parse(fs.readFileSync(file, "utf8"))
+    cached.vectors["a.md"].vector = [77, 1]
+    const replacement = `${file}.replacement`
+    fs.writeFileSync(replacement, JSON.stringify(cached))
+    fs.renameSync(replacement, file)
+
+    const result = await cachedDocumentVectors(documents, embed, options)
+    assert.equal(embedded, 1)
+    assert.deepEqual(result.get("a.md"), [77, 1])
+  } finally { fs.rmSync(directory, { recursive: true, force: true }) }
+})
+
+test("deletion and malformed replacement invalidate parsed vectors", async () => {
+  const directory = fs.mkdtempSync(path.join(os.tmpdir(), "graphmory-semantic-invalid-"))
+  try {
+    let embedded = 0
+    const embed = async (texts) => {
+      embedded += texts.length
+      return { tolist: () => texts.map((text) => [text.length, 1]) }
+    }
+    const options = { vault: directory, model: "test-model", modelCache: directory, maxDocumentCharacters: 100 }
+    const documents = [parseMarkdown("a.md", "# A\n\noriginal")]
+    await cachedDocumentVectors(documents, embed, options)
+    const initial = await cachedDocumentVectors(documents, embed, options)
+    const expectedVector = initial.get("a.md").slice()
+    assert.equal(embedded, 1)
+
+    let file = onlyVectorCacheFile(directory)
+    fs.unlinkSync(file)
+    let result = await cachedDocumentVectors(documents, embed, options)
+    assert.equal(embedded, 2)
+    assert.deepEqual(result.get("a.md"), expectedVector)
+
+    file = onlyVectorCacheFile(directory)
+    await cachedDocumentVectors(documents, embed, options)
+    fs.writeFileSync(file, "{")
+    result = await cachedDocumentVectors(documents, embed, options)
+    assert.equal(embedded, 3)
+    assert.deepEqual(result.get("a.md"), expectedVector)
+  } finally { fs.rmSync(directory, { recursive: true, force: true }) }
+})
+
