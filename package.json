{
  "name": "graphmory",
  "version": "0.5.0-rc.6",
  "description": "Governed memory for AI agents. A local MCP server over plain Markdown notes with cited recall and guarded writes.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Grunte12/graphmory.git"
  },
  "bugs": {
    "url": "https://github.com/Grunte12/graphmory/issues"
  },
  "homepage": "https://github.com/Grunte12/graphmory#readme",
  "optionalDependencies": {
    "@huggingface/transformers": "^3.4.0"
  },
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "graphmory": "scripts/brain-sync.mjs",
    "graphmory-setup": "scripts/setup-curator-agent.mjs",
    "graphmory-mcp": "scripts/graphmory-mcp.mjs"
  },
  "files": [
    "adapters/",
    "docs/design/architecture.md",
    "docs/design/adaptive-retrieval-loop.md",
    "docs/evaluation/cost-and-scale.md",
    "docs/evaluation/evaluation.md",
    "docs/guides/install.md",
    "docs/guides/agent-hosts.md",
    "docs/guides/mcp-hosts.md",
    "docs/research/positioning.md",
    "docs/guides/memory-contracts.md",
    "docs/guides/cli-reference.md",
    "docs/guides/mcp-http.md",
    "docs/guides/curator-workflow-smoke.md",
    "docs/guides/managed-retrieval.md",
    "docs/guides/token-efficient-language.md",
    "docs/guides/knowledge-graph.md",
    "docs/guides/vault-setup.md",
    "docs/design/learning-loop.md",
    "docs/guides/portable-brain-sync.md",
    "docs/research/research-foundations.md",
    "docs/guides/troubleshooting.md",
    "examples/",
    "eval/local-rerank/",
    "schemas/",
    "scripts/brain-sync.mjs",
    "scripts/init-project.mjs",
    "scripts/install.mjs",
    "scripts/setup-curator-agent.mjs",
    "scripts/recommend-curation.mjs",
    "scripts/render-hot-context.mjs",
    "scripts/validate.mjs",
    "skills/",
    "src/",
    "AGENTS.md",
    "CHANGELOG.md",
    "CITATION.cff",
    "CODE_OF_CONDUCT.md",
    "CONTRIBUTING.md",
    "PRIVACY.md",
    "SECURITY.md",
    "SUPPORT.md",
    "THIRD_PARTY_NOTICES.md",
    "docs/guides/trial-mvp.md",
    "docs/guides/hybrid-summary.md",
    "scripts/graphmory-mcp.mjs",
    "docs/glossary.md",
    "docs/evaluation/live-model-results.md",
    "docs/guides/demo-workflow.md",
    "docs/guides/mcp-recall.md",
    "docs/guides/mcp-remember.md",
    "docs/assets/graphmory-banner.png",
    "docs/assets/graphmory-architecture.png",
    "docs/assets/graphmory-engine.png"
  ],
  "scripts": {
    "test": "node --test",
    "validate:examples": "node scripts/validate.mjs examples/memory-patch.json && node scripts/validate.mjs examples/brain-brief.json && node scripts/validate.mjs examples/brain-brief-no-evidence.json && node scripts/validate.mjs examples/derived-index.json && node scripts/validate.mjs examples/hot-context-pack.json && node scripts/validate.mjs examples/learning-packet.json",
    "eval:retrieval": "node scripts/eval-retrieval.mjs",
    "eval:retrieval:stress": "node scripts/eval-retrieval-stress.mjs",
    "eval:retrieval:semantic": "node scripts/eval-semantic-retrieval.mjs",
    "eval:v05-gate": "node scripts/eval-v05-gate.mjs",
    "eval:lifecycle": "node scripts/eval-lifecycle-audit.mjs",
    "eval:conflict": "node scripts/eval-conflict-assist.mjs",
    "eval:deep-paging": "node scripts/eval-deep-paging.mjs",
    "eval:rerank": "node scripts/eval-rerank.mjs",
    "eval:live-agent-score": "node scripts/eval-live-agent-score.mjs",
    "eval:vault": "node scripts/eval-vault-retrieval.mjs",
    "eval:managed": "node scripts/eval-managed-recall.mjs",
    "eval:longmemeval": "node scripts/eval-longmemeval.mjs",
    "eval:graph:hard": "node scripts/eval-graph-hard.mjs --out eval/graph-hard/results.json",
    "eval:adaptive-graph": "node scripts/eval-adaptive-graph.mjs --vault eval/real-vault/vault --queries eval/real-vault/queries.json",
    "eval:agent-output": "node scripts/eval-agent-output.mjs --vault eval/real-vault/vault --queries eval/real-vault/queries.json",
    "eval:structure": "node scripts/eval-vault-structure.mjs",
    "eval:query-reformulation": "node scripts/eval-query-reformulation.mjs --vault eval/real-vault/vault --queries eval/real-vault/queries.json --reformulations eval/real-vault/reformulated-queries.json",
    "eval:curator": "node scripts/eval-curator.mjs",
    "eval:curator:compare": "node scripts/eval-curator.mjs --candidate eval/curator/candidates --allow-failures",
    "eval:patch-quality": "node scripts/eval-patch-quality.mjs",
    "eval:learning-loop": "node scripts/eval-learning-loop.mjs",
    "eval:future-task": "node scripts/eval-future-task.mjs",
    "eval:report": "node scripts/eval-report.mjs",
    "eval:agent-run": "node scripts/eval-agent-run.mjs",
    "release:gate": "node scripts/release-gate.mjs",
    "recommend:curation": "node scripts/recommend-curation.mjs",
    "eval": "npm run eval:retrieval && npm run eval:v05-gate && npm run eval:lifecycle && npm run eval:conflict && npm run eval:deep-paging && npm run eval:curator && npm run eval:patch-quality && npm run eval:learning-loop && npm run eval:future-task",
    "hot-context:render": "node scripts/render-hot-context.mjs",
    "brain:sync": "node scripts/brain-sync.mjs",
    "bench:scale": "node scripts/bench-scale.mjs",
    "check": "npm run test && npm run validate:examples && npm run eval"
  },
  "keywords": [
    "agent-memory",
    "opencode",
    "obsidian",
    "context-engineering",
    "llm",
    "coding-agents",
    "rag",
    "memory",
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "markdown"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.0",
    "zod": "^4.6.5"
  },
  "author": "Grunte12"
}
