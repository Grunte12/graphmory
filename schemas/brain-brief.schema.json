{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Grunte12/graphmory/main/schemas/brain-brief.schema.json",
  "title": "Brain Brief",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "relevant_memory",
    "constraints",
    "watchouts",
    "note_paths",
    "direct_read_paths"
  ],
  "properties": {
    "outcome": {
      "type": "string",
      "enum": [
        "answered",
        "no-evidence",
        "partial"
      ],
      "default": "answered",
      "description": "no-evidence means recall found nothing that supports an answer; the Lead must say \"no supporting note\" and not guess."
    },
    "stop_reason": {
      "type": "string",
      "enum": [
        "nothing-relevant-left",
        "evidence-sufficient",
        "budget",
        "scan-limit"
      ],
      "description": "Why the Curator stopped paging."
    },
    "pages_read": {
      "type": "integer",
      "minimum": 0,
      "description": "Recall pages the Curator read before stopping."
    },
    "relevant_memory": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "summary",
          "path"
        ],
        "properties": {
          "summary": {
            "type": "string",
            "minLength": 3
          },
          "path": {
            "type": "string",
            "minLength": 3
          },
          "hash": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$",
            "description": "sha256 of the note as recalled, so the source of each finding can be checked."
          }
        }
      }
    },
    "constraints": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "watchouts": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "note_paths": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "direct_read_paths": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "type": "string"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "outcome": {
            "const": "no-evidence"
          }
        },
        "required": [
          "outcome"
        ]
      },
      "then": {
        "properties": {
          "relevant_memory": {
            "maxItems": 0
          },
          "note_paths": {
            "maxItems": 0
          },
          "direct_read_paths": {
            "maxItems": 0
          }
        }
      },
      "else": {
        "properties": {
          "relevant_memory": {
            "minItems": 1
          },
          "note_paths": {
            "minItems": 1
          }
        }
      }
    }
  ]
}
