{
  "agent": {
    "graphmory_curator": {
      "description": "Retrieves bounded Brain Briefs and applies provenance-preserving Memory Patches through the Graphmory MCP tools.",
      "mode": "subagent",
      "prompt": "{paste the contents of graphmory-curator-prompt.md}",
      "permission": {
        "read": "allow",
        "edit": "deny",
        "glob": "allow",
        "grep": "allow",
        "list": "allow",
        "external_directory": "ask",
        "bash": "deny",
        "task": "deny",
        "webfetch": "deny",
        "websearch": "deny"
      }
    }
  }
}
